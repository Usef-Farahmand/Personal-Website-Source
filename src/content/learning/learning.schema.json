{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Learning entries (learning.json)",
  "type": "array",
  "items": { "$ref": "#/definitions/entry" },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "Button text (English; not localized)." },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "snippet": {
      "type": "object",
      "required": ["language", "code"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "description": "Display label, e.g. TypeScript, C#, YAML." },
        "filename": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "block": {
      "description": "A bare string is a paragraph. Use `backticks` for inline code.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": { "type": { "const": "paragraph" }, "text": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "heading" },
            "text": { "type": "string" },
            "level": { "enum": [2, 3], "description": "2 = section (default), 3 = sub-heading." }
          }
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "list" },
            "items": { "type": "array", "items": { "type": "string" } },
            "ordered": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "headers", "rows"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "table" },
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        },
        {
          "type": "object",
          "required": ["type", "src", "alt"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string", "description": "Local /public path or an allow-listed remote host (next.config.ts)." },
            "alt": { "type": "string" },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "translation": {
      "type": "object",
      "required": ["title", "summary", "content"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string", "description": "Short teaser for cards and the meta description." },
        "content": { "type": "array", "items": { "$ref": "#/definitions/block" } }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "slug", "date", "tags", "relatedProjectIds", "relatedArticleIds", "translations"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique id, e.g. learn-my-topic." },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "URL segment (/learning/<slug>). Unique and stable." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD. The list sorts by this, newest first." },
        "imageUrl": { "type": "string", "description": "Optional; falls back to the site logo." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "codeSnippets": { "type": "array", "items": { "$ref": "#/definitions/snippet" } },
        "sourceCodeUrl": { "type": "string", "format": "uri" },
        "externalLinks": { "type": "array", "items": { "$ref": "#/definitions/link" } },
        "relatedProjectIds": { "type": "array", "items": { "type": "string" }, "description": "Ids from projects.json, e.g. prj-snapshot-all." },
        "relatedArticleIds": { "type": "array", "items": { "type": "string" }, "description": "Ids from articles.json, e.g. art-snapshot-all." },
        "translations": {
          "type": "object",
          "required": ["en"],
          "additionalProperties": false,
          "properties": {
            "en": { "$ref": "#/definitions/translation" },
            "fa": { "$ref": "#/definitions/translation" }
          }
        }
      }
    }
  }
}
