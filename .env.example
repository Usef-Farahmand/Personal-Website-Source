# Copy this file to .env.local and fill in the values.
# On Vercel, set the same variables under Settings → Environment Variables.
# Setup guide: doc/EMAILJS_SETUP.md

# Contact form — EmailJS, server-side only (never prefix with NEXT_PUBLIC_).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional: override the canonical site URL used for metadata and OG images.
# NEXT_PUBLIC_SITE_URL=https://www.useffarahmand.com
