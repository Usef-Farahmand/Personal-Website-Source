// Local CMS database schema.
//
// This schema is intentionally NOT a 1:1 mirror of the public website's
// `src/types/content.ts` shapes. The CMS is the *authoring* representation;
// the public website consumes a separately-exported, stable representation
// (see Task 01 deliverables notes on the Publish boundary). Keeping these
// two decoupled is what lets either side evolve without forcing a matching
// change in the other.
//
// Enums vs. plain strings, and why this changed from Task 01:
// SQLite has no *native* enum column type, but Prisma ORM (6.2.0+) accepts
// `enum` blocks for SQLite and enforces them at the Prisma layer — the
// column is still TEXT underneath, but the generated Client and schema
// validation reject anything outside the declared values. That's what
// Task 02 asks for ("use a Prisma enum if appropriate"), so ContentStatus,
// Locale, and MediaType are now real Prisma enums instead of the
// Zod-only `String` fields Task 01 used. Prisma still doesn't emit a DB
// CHECK constraint for SQLite, so a raw `sqlite3 dev.db` edit could still
// write an invalid value — the Zod schemas in `src/lib/validation/` remain
// the second, defense-in-depth layer for anything written outside Prisma
// Client, and now import their allowed values directly from these enums
// (see shared.ts) instead of duplicating the list.
//
// `category`, `platforms`, `technologies`, and `tags` are NOT Prisma enums:
// `category` is a closed vocabulary but validated by Zod only (see
// shared.ts's projectCategorySchema/articleCategorySchema) — kept as a
// plain String so it isn't a second, DB-level source of truth to keep in
// sync with the public site's ProjectCategory/ArticleCategory unions.
// `platforms`/`technologies`/`tags` are open-ended lists with no fixed
// vocabulary at all, stored as Json (SQLite: TEXT under the hood).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

/// Every manageable content item's lifecycle state (Project, Article).
/// DRAFT = editable, not published. PUBLISHED = eligible for static
/// export. ARCHIVED = retained in the CMS, excluded from export.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Currently supported translation locales. Adding a language later is a
/// migration (new enum value) plus new ProjectTranslation/
/// ArticleTranslation rows — no schema restructuring, which is what "the
/// architecture must allow additional languages later" requires without
/// needing an open-ended, unvalidated string.
enum Locale {
  en
  fa
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  /// cuid() — collision-resistant, sortable-ish, and doesn't leak a
  /// creation-order sequence the way autoincrement() would. That's the
  /// standard robust choice for a Prisma-managed local CMS and there's no
  /// reason (e.g. multi-writer sync, external ID collisions) to reach for
  /// anything heavier here.
  id   String @id @default(cuid())
  slug String @unique

  status   ContentStatus @default(DRAFT)
  featured Boolean       @default(false)

  /// Non-localized structured fields (shared across locales), per Task 01's
  /// Project Data Model. Stored as Json string[] — see file-level comment.
  technologies Json // string[]
  platforms    Json // string[]

  startDate DateTime?
  endDate   DateTime?

  /// Kept as three named optional URLs rather than one Json blob: these are
  /// the fixed, well-known outcome links (mirrors Project.links on the
  /// public site), not an open-ended set — a typed column per link keeps
  /// them queryable/validatable individually.
  websiteUrl    String?
  repositoryUrl String?
  liveUrl       String?

  /// Brand mark, referenced by id — optional, matches the public site's
  /// "falls back to a category icon when absent" convention. onDelete:
  /// SetNull — deleting a Media record that happens to be someone's logo
  /// should detach it gracefully, not block the deletion or take the
  /// Project down with it.
  logoMediaId String?
  logo        Media?  @relation("ProjectLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  /// Card/detail-page banner image. Not explicitly listed in Task 01's
  /// field list, but required by the existing public content model
  /// (Project.coverImageUrl) — added here as a documented assumption
  /// (see deliverables: Assumptions). Same SetNull reasoning as `logo`.
  coverMediaId String?
  cover        Media?  @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ProjectTranslation[]
  gallery      ProjectMedia[]

  /// Supports the CMS's own "list drafts" / "list published" filtering,
  /// and later the export step's "give me everything PUBLISHED" query —
  /// both filter on status first, so it's a clear win rather than a
  /// speculative index.
  @@index([status])
  @@index([logoMediaId])
  @@index([coverMediaId])
}

model ProjectTranslation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  locale Locale

  title            String
  shortDescription String
  /// Renamed from Task 01's `fullDescription` to match Task 02's field
  /// list exactly.
  description      String

  /// Localized per Task 01/02's explicit field list. In practice this
  /// value is expected to stay identical across a Project's locales (it
  /// is a taxonomy key, not prose) — flagged as an assumption to
  /// reconcile when the export mapping to the public site's shared
  /// `ProjectCategory` enum is designed. See deliverables: Assumptions.
  category String

  /// Localized tag labels — genuinely translatable, unlike `category`.
  /// Carried over from Task 01; not in Task 02's restated field list, but
  /// nothing in Task 02 asks to remove it, and it's exercised by the
  /// existing public site model. See deliverables: Assumptions.
  tags Json // string[]

  /// Per-locale SEO metadata, new in Task 02. Optional — most content
  /// won't need copy distinct from `title`/`shortDescription`, so this
  /// isn't required at creation time; a future service can fall back to
  /// those fields when these are empty.
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The core localization constraint: one Project cannot have two
  /// translation rows for the same locale. This is what makes "the same
  /// Project identity regardless of language" actually enforced rather
  /// than just a convention.
  @@unique([projectId, locale])
  /// projectId is already covered by the composite unique index above
  /// (it's the leading column, so SQLite can use it for "all
  /// translations of this project" lookups too) — no separate index
  /// needed on projectId alone.
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Article
// ---------------------------------------------------------------------------

model Article {
  id   String @id @default(cuid())
  slug String @unique

  status   ContentStatus @default(DRAFT)
  featured Boolean       @default(false)

  /// Articles are external publications — the CMS stores metadata and the
  /// source URL only, never the article body (Task 01: Article Data
  /// Model). Retained from Task 01; Task 02's restated field list omits
  /// it, but nothing asks to remove it and it's structurally required for
  /// an "external publication" record to be useful at all.
  sourceUrl   String
  publishedAt DateTime?

  headerMediaId String?
  headerImage   Media?  @relation("ArticleHeaderImage", fields: [headerMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ArticleTranslation[]

  @@index([status])
  /// Articles are typically listed newest-first by publish date — a
  /// direct match for how the public site's ArticleGrid/listing already
  /// sorts, and a query the CMS's own future list view will run
  /// constantly once publishedAt is set.
  @@index([publishedAt])
  @@index([headerMediaId])
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  locale Locale

  title   String
  summary String

  /// See the same category/tags note as ProjectTranslation above.
  category String
  tags     Json // string[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, locale])
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Media
//
// One reusable entity for images, videos, and PDFs — mirrors the public
// site's MediaItem convention (a single closed `type` union rather than
// per-kind tables) so the future export step is a straightforward mapping,
// not a reshaping. Kept intentionally narrow: no dedicated Media Library UI
// or upload pipeline yet (Task 01 explicitly excludes it) — this model only
// needs to support Project/Article's current references to it.
//
// Every field below `type` is optional, deliberately: an image typically
// has a thumbnail, a PDF usually doesn't, a video's "thumbnail" is really
// a poster frame, and `downloadUrl` only makes sense when `downloadable`
// is true. Nothing here forces a media kind to populate a field that
// doesn't apply to it.
// ---------------------------------------------------------------------------

model Media {
  id String @id @default(cuid())

  type MediaType

  title       String?
  description String?

  /// Local file path or URL — no upload handling yet, this is populated by
  /// hand (or a future import script) at this stage of the CMS.
  source    String
  thumbnail String?

  downloadable Boolean @default(false)
  downloadUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectGalleryEntries ProjectMedia[]
  projectLogos          Project[]      @relation("ProjectLogo")
  projectCovers         Project[]      @relation("ProjectCover")
  articleHeaders        Article[]      @relation("ArticleHeaderImage")
}

/// Join table between Project and Media for the gallery collection — a
/// many-to-many with a defined display order, which a plain implicit m2m
/// relation can't express in Prisma. No separate "role" field: Task 02
/// offers it as optional ("if useful"), but logo/cover already have their
/// own dedicated relations above, so everything reachable through this
/// join is unambiguously "gallery" — a role column would have exactly one
/// value in practice. Keeping it out now is the "don't over-engineer"
/// call; add it later if a real second role (e.g. "video walkthrough" vs.
/// "screenshot") shows up.
model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  /// onDelete: Cascade here — if the underlying Media is deleted, this
  /// join row is meaningless and should go with it. This is the reverse
  /// direction from item 13's "deleting a ProjectMedia relationship
  /// should not accidentally delete Media": deleting the *join row*
  /// never touches Media (no cascade is configured in that direction);
  /// this cascade only fires when Media itself is deleted, to avoid an
  /// orphaned join row pointing at nothing.
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([projectId, mediaId])
  @@index([projectId, order])
  /// Reverse lookup — "which Projects use this Media item" — matters
  /// once a Media Library UI exists and needs to warn before deleting
  /// something still in use elsewhere.
  @@index([mediaId])
}
