// Local CMS database schema.
//
// This schema is intentionally NOT a 1:1 mirror of the public website's
// `src/types/content.ts` shapes. The CMS is the *authoring* representation;
// the public website consumes a separately-exported, stable representation
// (see Task 01 deliverables notes on the Publish boundary). Keeping these
// two decoupled is what lets either side evolve without forcing a matching
// change in the other.
//
// Enums vs. plain strings, and why this changed from Task 01:
// SQLite has no *native* enum column type, but Prisma ORM (6.2.0+) accepts
// `enum` blocks for SQLite and enforces them at the Prisma layer — the
// column is still TEXT underneath, but the generated Client and schema
// validation reject anything outside the declared values. That's what
// Task 02 asks for ("use a Prisma enum if appropriate"), so ContentStatus,
// Locale, and MediaType are now real Prisma enums instead of the
// Zod-only `String` fields Task 01 used. Prisma still doesn't emit a DB
// CHECK constraint for SQLite, so a raw `sqlite3 dev.db` edit could still
// write an invalid value — the Zod schemas in `src/lib/validation/` remain
// the second, defense-in-depth layer for anything written outside Prisma
// Client, and now import their allowed values directly from these enums
// (see shared.ts) instead of duplicating the list.
//
// `category`, `platforms`, `technologies`, and `tags` are NOT Prisma enums:
// `category` is a closed vocabulary but validated by Zod only (see
// shared.ts's projectCategorySchema/articleCategorySchema) — kept as a
// plain String so it isn't a second, DB-level source of truth to keep in
// sync with the public site's ProjectCategory/ArticleCategory unions.
// `platforms`/`technologies`/`tags` are open-ended lists with no fixed
// vocabulary at all, stored as Json (SQLite: TEXT under the hood).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

/// Every manageable content item's lifecycle state (Project, Article).
/// DRAFT = editable, not published. PUBLISHED = eligible for static
/// export. ARCHIVED = retained in the CMS, excluded from export.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Currently supported translation locales. Adding a language later is a
/// migration (new enum value) plus new ProjectTranslation/
/// ArticleTranslation rows — no schema restructuring, which is what "the
/// architecture must allow additional languages later" requires without
/// needing an open-ended, unvalidated string.
enum Locale {
  en
  fa
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

/// Task 05 compatibility fix: the public site's ArticleSourcePlatform
/// (src/types/content.ts) is a closed "medium" | "linkedin" union, but
/// Task 05 #8 explicitly asks for Medium/LinkedIn/Website/Other — a
/// broader set the public type doesn't cover yet. WEBSITE/OTHER are
/// included here on the CMS side now (an article CAN be self-hosted or
/// from an unlisted platform); reconciling the public union to match is
/// left to the future export/rendering task, per Task 05 #19's "do not
/// change public rendering unnecessarily." See deliverables: Assumptions.
enum ArticleSourcePlatform {
  MEDIUM
  LINKEDIN
  WEBSITE
  OTHER
}

/// Task 04 compatibility fix (see ProjectLink below for the full story):
/// the well-known outcome-link "slots" the public site's Project.links
/// renders as dedicated CTAs, plus OTHER for anything that isn't one of
/// them. Not exhaustive of every possible platform (that's what OTHER +
/// `label` is for) — exhaustive of the ones the public site gives a
/// distinct rendering treatment to.
enum ProjectLinkType {
  WEBSITE
  REPOSITORY
  PLAYABLE
  DOWNLOAD
  APP_STORE
  GOOGLE_PLAY
  OTHER
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  /// cuid() — collision-resistant, sortable-ish, and doesn't leak a
  /// creation-order sequence the way autoincrement() would. That's the
  /// standard robust choice for a Prisma-managed local CMS and there's no
  /// reason (e.g. multi-writer sync, external ID collisions) to reach for
  /// anything heavier here.
  id   String @id @default(cuid())
  slug String @unique

  status   ContentStatus @default(DRAFT)
  featured Boolean       @default(false)

  /// Non-localized structured fields (shared across locales), per Task 01's
  /// Project Data Model. Stored as Json string[] — see file-level comment.
  technologies Json // string[]
  platforms    Json // string[]

  /// Task 06.1: the public site's Project.releaseYear (types/content.ts) —
  /// missing from the schema entirely until now. Optional, matching the
  /// public type (a project can be started/ongoing with no shipped year
  /// yet).
  releaseYear Int?

  startDate DateTime?
  endDate   DateTime?

  /// Task 06.1: authoring/display order (public site's Project.order).
  /// Missing until now — the CMS list previously only supported
  /// updatedAt/title sort (see queries/projects.ts ProjectSort). Kept as a
  /// plain field an author can edit directly rather than drag-and-drop
  /// reordering, consistent with "keep it simple" for a single-author CMS.
  order Int @default(0)

  /// Task 06.1: the public site's Project.relatedProjectIds /
  /// relatedArticleIds / experienceId (types/content.ts) — cross-content
  /// references, missing from the schema entirely until now.
  ///
  /// relatedProjectIds stores *this* CMS's own Project.id values (Json
  /// string[]) — a plain id list rather than an explicit self-relation
  /// join table, matching the "avoid unnecessary normalization" guidance
  /// for a small personal-portfolio CMS. Migrated Projects keep their
  /// original site id (see scripts/migrate-projects.ts) specifically so
  /// these references resolve immediately after migration.
  relatedProjectIds Json @default("[]") // string[] of Project.id

  /// Articles and Experience entries are not both fully migrated into
  /// this CMS yet (Experience has no CMS model at all — out of scope for
  /// this task per section 22). These two fields preserve the *original*
  /// site content ids as opaque external references rather than a
  /// Prisma relation, so no data is lost; reconciling them to real CMS
  /// ids is left to whichever future task migrates Articles/Experience
  /// data the same way this task migrates Projects.
  relatedArticleIds Json @default("[]") // string[] of external Article ids
  experienceId String? // external Experience id, not a CMS relation yet

  /// Task 04 compatibility fix: Task 01/02 modeled outcome links as three
  /// named optional URL columns (website/repository/live). Inspecting the
  /// public site's actual Project.links (src/types/content.ts) during
  /// Task 04 found it needs six distinct slots (website, playable,
  /// download, appStore, googlePlay, repository) *plus* a separate
  /// open-ended `externalLinks: {label,url}[]` for anything else
  /// (Steam, itch.io, docs, press...). Three fixed columns can represent
  /// neither the full fixed set nor the open-ended one, and Task 04 #10
  /// explicitly says not to hardcode a fixed link set into the UI if the
  /// content model can instead support something more flexible. Smallest
  /// change that covers both: one ordered `ProjectLink` row per link,
  /// `type` distinguishing a known CTA slot from OTHER (→ rendered via
  /// `label`, matching externalLinks). See deliverables: Assumptions.
  links ProjectLink[]

  /// Brand mark, referenced by id — optional, matches the public site's
  /// "falls back to a category icon when absent" convention. onDelete:
  /// SetNull — deleting a Media record that happens to be someone's logo
  /// should detach it gracefully, not block the deletion or take the
  /// Project down with it.
  logoMediaId String?
  logo        Media?  @relation("ProjectLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  /// Card/detail-page banner image. Not explicitly listed in Task 01's
  /// field list, but required by the existing public content model
  /// (Project.coverImageUrl) — added here as a documented assumption
  /// (see deliverables: Assumptions). Same SetNull reasoning as `logo`.
  coverMediaId String?
  cover        Media?  @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ProjectTranslation[]
  gallery      ProjectMedia[]

  /// Task 06.1: Project Team support (see ProjectTeamMember below). A
  /// Project owns an ordered list of collaborators — solo projects simply
  /// have none, matching the public site's "absent/empty means solo"
  /// convention for Project.team.
  team ProjectTeamMember[]

  /// Supports the CMS's own "list drafts" / "list published" filtering,
  /// and later the export step's "give me everything PUBLISHED" query —
  /// both filter on status first, so it's a clear win rather than a
  /// speculative index.
  @@index([status])
  @@index([logoMediaId])
  @@index([coverMediaId])
}

model ProjectTranslation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  locale Locale

  title            String
  shortDescription String
  /// Renamed from Task 01's `fullDescription` to match Task 02's field
  /// list exactly.
  description      String

  /// Localized per Task 01/02's explicit field list. In practice this
  /// value is expected to stay identical across a Project's locales (it
  /// is a taxonomy key, not prose) — flagged as an assumption to
  /// reconcile when the export mapping to the public site's shared
  /// `ProjectCategory` enum is designed. See deliverables: Assumptions.
  category String

  /// Localized tag labels — genuinely translatable, unlike `category`.
  /// Carried over from Task 01; not in Task 02's restated field list, but
  /// nothing in Task 02 asks to remove it, and it's exercised by the
  /// existing public site model. See deliverables: Assumptions.
  tags Json // string[]

  /// Per-locale SEO metadata, new in Task 02. Optional — most content
  /// won't need copy distinct from `title`/`shortDescription`, so this
  /// isn't required at creation time; a future service can fall back to
  /// those fields when these are empty.
  seoTitle       String?
  seoDescription String?

  /// Task 06.1: the public site's ProjectTranslation carries several
  /// narrative/structured fields (types/content.ts) this schema never
  /// had a column for. Added here, all optional, matching the public
  /// type exactly (a Draft can omit any of them). `research`, `design`,
  /// `architecture`, `implementation`, `goals`, `challenges`, and
  /// `timeline` from the public type are deliberately NOT added here —
  /// no existing project uses them (see deliverables: Assumptions) and
  /// section 22 asks not to over-build the schema; add them in a future
  /// task if real content needs them.
  problem          String?
  solution         String?
  lessonsLearned   String?
  targetAudience   String?
  myRole           String?
  /// ProjectFeatureHighlight[] (public site type) — {icon, title,
  /// description}[], stored as Json rather than a child table: it's a
  /// short, order-preserving, no-independent-identity list, the same
  /// reasoning as `tags` above.
  featureHighlights Json? // ProjectFeatureHighlight[] | null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The core localization constraint: one Project cannot have two
  /// translation rows for the same locale. This is what makes "the same
  /// Project identity regardless of language" actually enforced rather
  /// than just a convention.
  @@unique([projectId, locale])
  /// projectId is already covered by the composite unique index above
  /// (it's the leading column, so SQLite can use it for "all
  /// translations of this project" lookups too) — no separate index
  /// needed on projectId alone.
  @@index([locale])
}

/// A single outcome/external link on a Project. See Project.links above
/// for why this replaced the three fixed URL columns. `order` preserves
/// authoring order for the public site's externalLinks section, same
/// reasoning as ProjectMedia.order for the gallery. Not localized — a
/// URL and its short label (e.g. "Steam", "App Store") don't change by
/// language, consistent with ExternalLink on the public site.
model ProjectLink {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type  ProjectLinkType @default(OTHER)
  label String
  url   String
  order Int             @default(0)

  @@index([projectId, order])
}

/// Task 06.1: a Project collaborator (public site's TeamMember). Deliberately
/// scoped to "belongs to one Project" per the task's Team Data Model
/// section — NOT a global Person entity. The same human appearing on
/// multiple Projects today is just multiple ProjectTeamMember rows with
/// the same `name`; introducing a shared Person table is exactly the
/// "unnecessary normalization" the task says to avoid for a small
/// personal-portfolio CMS. `avatarUrl` (present on the public site's
/// TeamMember) is intentionally omitted — no migrated project uses it,
/// and the CMS Media system would be the right way to add it later
/// rather than a bare URL string now.
model ProjectTeamMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name  String
  order Int    @default(0)

  links ProjectTeamMemberLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

/// One team member's profile link (LinkedIn, personal site, ...). Reuses
/// the plain {label, url} shape — same as ProjectLink's `label` and the
/// public site's ExternalLink — rather than a closed platform enum: a
/// collaborator's links are exactly as open-ended as a project's
/// externalLinks, and the task explicitly says not every member has
/// e.g. a LinkedIn, so nothing here is required beyond label/url.
model ProjectTeamMemberLink {
  id           String            @id @default(cuid())
  teamMemberId String
  teamMember   ProjectTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  label String
  url   String
  order Int    @default(0)

  @@index([teamMemberId, order])
}

// ---------------------------------------------------------------------------
// Article
// ---------------------------------------------------------------------------

model Article {
  id   String @id @default(cuid())
  slug String @unique

  status   ContentStatus @default(DRAFT)
  featured Boolean       @default(false)

  /// Articles are external publications — the CMS stores metadata and the
  /// source URL only, never the article body (Task 01: Article Data
  /// Model). Retained from Task 01; Task 02's restated field list omits
  /// it, but nothing asks to remove it and it's structurally required for
  /// an "external publication" record to be useful at all.
  sourceUrl   String
  /// Task 05 #8 compatibility fix: absent from Task 01/02's model
  /// entirely. See the enum's comment above for why WEBSITE/OTHER exist
  /// alongside the public site's current medium/linkedin.
  sourcePlatform ArticleSourcePlatform @default(OTHER)
  publishedAt    DateTime?

  /// Task 05 #20 compatibility fix: the public site's Article.readingTimeMinutes
  /// is required to render an article card/page, but nothing in Task
  /// 01/02's model captures it — the original site computed it from a
  /// `body` this CMS deliberately never stores (external publications).
  /// Nullable + authored by hand (there's no body here to derive it
  /// from): a Draft can omit it, same reasoning as Project.startDate.
  readingTimeMinutes Int?

  /// Task 06.2: fields the public site's Article type (types/content.ts)
  /// carries that this schema never had a column for — same reasoning
  /// as Project's equivalent additions in Task 06.1.
  /// `order` — explicit authoring/display order (site's Article.order).
  order Int @default(0)
  /// `relatedProjectIds` references this CMS's own Project.id values —
  /// migrated Projects (Task 06.1) kept their original site ids, so
  /// these resolve immediately. `relatedArticleIds` references this
  /// CMS's own Article.id values for the same reason: this migration
  /// preserves original Article ids too (see scripts/migrate-articles.ts).
  /// Both plain Json id lists rather than relation tables — same
  /// "avoid unnecessary normalization" reasoning as Project's fields.
  relatedProjectIds Json @default("[]") // string[] of Project.id
  relatedArticleIds Json @default("[]") // string[] of Article.id
  /// `coAuthors` — plain string[] of names. No structure beyond that in
  /// the source data (unlike Project's Team, these aren't links to
  /// profiles) — a Json string list is the direct, non-over-engineered
  /// match.
  coAuthors Json @default("[]") // string[]

  headerMediaId String?
  headerImage   Media?  @relation("ArticleHeaderImage", fields: [headerMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ArticleTranslation[]

  @@index([status])
  /// Articles are typically listed newest-first by publish date — a
  /// direct match for how the public site's ArticleGrid/listing already
  /// sorts, and a query the CMS's own future list view will run
  /// constantly once publishedAt is set.
  @@index([publishedAt])
  @@index([headerMediaId])
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  locale Locale

  title   String
  summary String

  /// See the same category/tags note as ProjectTranslation above.
  category String
  tags     Json // string[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, locale])
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Media
//
// One reusable entity for images, videos, and PDFs — mirrors the public
// site's MediaItem convention (a single closed `type` union rather than
// per-kind tables) so the future export step is a straightforward mapping,
// not a reshaping. Task 01/02 kept this narrow (no Media Library UI or
// upload pipeline); Task 06 adds real local file upload + management on
// top of the same model — see originalFilename/mimeType/fileSize below.
//
// Every field below `type` is optional, deliberately: an image typically
// has a thumbnail, a PDF usually doesn't, a video's "thumbnail" is really
// a poster frame, and `downloadUrl` only makes sense when `downloadable`
// is true. Nothing here forces a media kind to populate a field that
// doesn't apply to it.
// ---------------------------------------------------------------------------

model Media {
  id String @id @default(cuid())

  type MediaType

  title       String?
  description String?

  /// Local file path (Task 06: `/uploads/{images,videos,pdfs}/<uuid>.<ext>`,
  /// always a portable, forward-slash public path — never a machine-specific
  /// absolute filesystem path). Pre-Task-06 rows may still hold a hand-typed
  /// path/URL from the old quick-add-by-URL flow; those simply have no
  /// corresponding entry under `public/uploads/` and are left alone by the
  /// upload/delete file-management code (see lib/media/storage.ts).
  source    String
  thumbnail String?

  /// Task 06 additions — populated for uploads made through
  /// /api/media/upload, left null for the pre-existing quick-add-by-URL
  /// rows (seed data, anything created before this task) since there is
  /// no real uploaded file to describe for those.
  /// The user's original filename, preserved for display only — never
  /// used as the on-disk filename (see generateStorageFilename).
  originalFilename String?
  /// Server-detected MIME type at upload time (browser-reported, used
  /// only for display/preview hints — never trusted for validation on
  /// its own; see the extension allowlist + signature sniff in
  /// lib/media/storage.ts).
  mimeType         String?
  /// Size in bytes at upload time, shown in the Media Library list/detail
  /// views.
  fileSize         Int?

  downloadable Boolean @default(false)
  downloadUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectGalleryEntries ProjectMedia[]
  projectLogos          Project[]      @relation("ProjectLogo")
  projectCovers         Project[]      @relation("ProjectCover")
  articleHeaders        Article[]      @relation("ArticleHeaderImage")
}

/// Join table between Project and Media for the gallery collection — a
/// many-to-many with a defined display order, which a plain implicit m2m
/// relation can't express in Prisma. No separate "role" field: Task 02
/// offers it as optional ("if useful"), but logo/cover already have their
/// own dedicated relations above, so everything reachable through this
/// join is unambiguously "gallery" — a role column would have exactly one
/// value in practice. Keeping it out now is the "don't over-engineer"
/// call; add it later if a real second role (e.g. "video walkthrough" vs.
/// "screenshot") shows up.
model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  /// onDelete: Cascade here — if the underlying Media is deleted, this
  /// join row is meaningless and should go with it. This is the reverse
  /// direction from item 13's "deleting a ProjectMedia relationship
  /// should not accidentally delete Media": deleting the *join row*
  /// never touches Media (no cascade is configured in that direction);
  /// this cascade only fires when Media itself is deleted, to avoid an
  /// orphaned join row pointing at nothing.
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([projectId, mediaId])
  @@index([projectId, order])
  /// Reverse lookup — "which Projects use this Media item" — matters
  /// once a Media Library UI exists and needs to warn before deleting
  /// something still in use elsewhere.
  @@index([mediaId])
}
